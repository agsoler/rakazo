+import path from "node:path";
+
+type ComputerHomePathInput = {
+  requestHomePath: string;
+  botId: string;
+  serviceDataDir: string;
+  clientDataDir?: string;
+};
+
+function pathApiFor(value: string): typeof path.posix | typeof path.win32 {
+  return /^[A-Za-z]:[\\/]/.test(value) || value.startsWith("\\\\") ? path.win32 : path.posix;
+}
+
+/** Resolve a validated client home path to the supervisor's mounted data directory. */
+export function resolveComputerHomePath(input: ComputerHomePathInput): string {
+  const servicePath = pathApiFor(input.serviceDataDir);
+  const serviceHomePath = servicePath.resolve(input.serviceDataDir, "homes", input.botId);
+  if (!input.clientDataDir) {
+    if (servicePath.resolve(input.requestHomePath) !== serviceHomePath) {
+      throw new Error("computer home must be the bot's home directory");
+    }
+    return serviceHomePath;
+  }
+
+  const clientPath = pathApiFor(input.clientDataDir);
+  const clientHomePath = clientPath.resolve(input.clientDataDir, "homes", input.botId);
+  if (clientPath.resolve(input.requestHomePath) !== clientHomePath) {
+    throw new Error("computer home must be the bot's home directory");
+  }
+  return serviceHomePath;
+}
